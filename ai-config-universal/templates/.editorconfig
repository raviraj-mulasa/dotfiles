# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Defaults across all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# ── Python (PEP 8) ────────────────────────────────────────────────────────────
[*.py]
indent_size = 4
max_line_length = 88

# ── Java & JVM Languages ──────────────────────────────────────────────────────
[*.{java,groovy,gradle,kt,kts}]
indent_size = 4

# ── Rust ──────────────────────────────────────────────────────────────────────
[*.rs]
indent_size = 4

# ── TypeScript / JavaScript & Frontend ────────────────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs,vue,svelte}]
indent_size = 2

# ── Dart & Flutter ────────────────────────────────────────────────────────────
[*.dart]
indent_size = 2

# ── Shell Scripts ─────────────────────────────────────────────────────────────
[*.{sh,bash,zsh}]
indent_size = 2

# ── Structured Data & Configs ─────────────────────────────────────────────────
[*.{json,json5,jsonc,yaml,yml,toml,xml,html,css,scss,less}]
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ── Makefiles ─────────────────────────────────────────────────────────────────
[Makefile]
indent_style = tab
